# Required for the contact form. Vite inlines these at build time.
# Also set the same three in Cloudflare Pages → Settings → Environment variables, then rebuild.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional. Overrides the public Carto Voyager key used for maps.
VITE_CARTO_API_KEY=
